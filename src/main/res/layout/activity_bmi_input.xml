<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F3E5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚖️ Weight Check"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#7B1FA2"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etWeightInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Weight (kg)"
        android:inputType="numberDecimal"
        android:padding="14dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etHeightInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Height (cm)"
        android:inputType="numberDecimal"
        android:padding="14dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnCalculateBMI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculate Analysis"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- RESULT BOX -->
    <TextView
        android:id="@+id/tvResultReceived"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter data to see analysis..."
        android:gravity="center"
        android:padding="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnBackBMI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard"
        android:backgroundTint="#757575"/>
</LinearLayout>